# GL Bajaj CampusOS Backend Configuration

# Database: PostgreSQL URL or local fallback (e.g. sqlite:///./campusos.db)
# For PostgreSQL: postgresql+psycopg://postgres:yourpassword@localhost:5432/campusos_db
DATABASE_URL=sqlite:///./campusos.db

# Authentication
JWT_SECRET_KEY=glb-campusos-super-secret-jwt-key-change-in-production-2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Google Gemini API
# Get your API key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# CORS
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173

# Environment: development / production
ENVIRONMENT=development
API_V1_PREFIX=/api/v1
